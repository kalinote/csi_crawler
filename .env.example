# RabbitMQ 配置
RABBITMQ_HOST=192.168.31.51
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=your_password_here
RABBITMQ_VHOST=/
# 以下分片配置均可不设置，默认使用 12 MiB 阈值、8 MiB 分片。
# CSI_RABBITMQ_FRAGMENT_THRESHOLD_BYTES=12582912
# CSI_RABBITMQ_FRAGMENT_BYTES=8388608
# CSI_RABBITMQ_MAX_LOGICAL_MESSAGE_BYTES=268435456

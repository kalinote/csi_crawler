{
    "meta": {
        "node_instance_id": "twitter_keyword",
        "action_id": "twitter_keyword"
    },
    "config": {
        "crawler_type": "keyword",
        "page": 1,
        "search_product": "Latest",
        "output": "output/twitter_keyword.json"
    },
    "inputs": {
        "platforms": {
            "type": "value",
            "value": ["twitter"]
        },
        "keywords": {
            "type": "value",
            "value": ["OpenAI"]
        },
        "resources_config": {
            "type": "value",
            "value": {
                "twitter": {
                    "cookies": {
                        "auth_token": "",
                        "ct0": ""
                    },
                    "headers": {
                        "Accept-Language": "zh-CN,zh;q=0.9",
                        "x-twitter-client-language": "zh-cn"
                    },
                    "proxy": null
                }
            }
        }
    },
    "outputs": {}
}
